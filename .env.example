# ---- Models -----------------------------------------------------------------
# Drives router / graders / generator. "gemini" (default), "openai", or "anthropic".
# Note: Gemini's free tier can be as low as 5 requests/minute for gemini-2.5-flash.
# The graph is designed to stay within that: document grading and the answer check
# each run as ONE batched LLM call (not one call per document/check), so a typical
# question costs ~4 LLM calls total. Every call also auto-retries on 429 using the
# provider's own suggested wait time (see LLM_MAX_RETRIES below) — no paid plan
# required, just an occasional short automatic wait if you ask several questions
# back-to-back. If you still hit limits often, try GEMINI_MODEL=gemini-2.5-flash-lite
# (typically a higher free-tier RPM ceiling).
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-sonnet-4-5
LLM_TEMPERATURE=0.0
LLM_MAX_RETRIES=6

# Embeddings: "hf" (local, free/offline, default — no rate limits, best for bulk
# ingestion), "gemini", or "openai".
EMBEDDINGS_PROVIDER=hf
HF_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Local cross-encoder reranker (no key needed). Keep true for best retrieval quality;
# set false if you want a fully API-only, torch-free footprint.
RERANKER_MODEL=BAAI/bge-reranker-base
USE_RERANKER=true

# Only relevant if EMBEDDINGS_PROVIDER=gemini above (its free tier caps embed_content
# at ~100 requests/minute per project). Ingestion batches and paces requests and
# retries 429s automatically. Unused with the default "hf" provider.
EMBED_BATCH_SIZE=90
EMBED_BATCH_DELAY=1.5
EMBED_MAX_RETRIES=6

# ---- API keys ---------------------------------------------------------------
# Get a Gemini key from Google AI Studio: https://aistudio.google.com/app/apikey
# The integration checks GOOGLE_API_KEY first, then GEMINI_API_KEY as a fallback —
# either name works, just set one.
GOOGLE_API_KEY=AIza...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# Optional but recommended: avoids Hugging Face Hub throttling anonymous downloads
# (the local embedding + reranker model weights, ~1.3GB total on first run). Free
# token: huggingface.co/settings/tokens (read access is enough).
# HF_TOKEN=hf_...

# Optional: enables the live web-search fallback. Without it the graph still runs.
# TAVILY_API_KEY=tvly-...

# ---- Retrieval knobs --------------------------------------------------------
COLLECTION_NAME=arxiv_papers
DENSE_K=12
SPARSE_K=12
FINAL_K=5
CHUNK_SIZE=1100
CHUNK_OVERLAP=150

# ---- Self-correction guards -------------------------------------------------
MAX_REWRITES=2
MAX_GENERATIONS=2
RECURSION_LIMIT=25

# ---- Optional: LangSmith tracing -------------------------------------------
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls-...
# LANGCHAIN_PROJECT=research-rag-assistant
